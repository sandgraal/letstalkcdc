# Let's Talk CDC environment variables
# Reference list of variable names only. Nothing in this repo loads a .env
# file: pass these inline on the command line (for example
# `SUPABASE_URL=... npm run dev`) or set them as GitHub Actions variables.
# See docs/SETUP.md, "Set Variables Inline".

# Assistant feedback (optional) - Supabase, read at build time.
# Leave both unset (local dev, forks) and the site still works: feedback
# votes only queue in localStorage under "assistantFeedback".
# Find them in the Supabase Dashboard: Project URL, and Project Settings ->
# API Keys -> publishable key. Use the PUBLISHABLE key (sb_publishable_...)
# only; it is safe in the browser because row-level security limits it to
# INSERT on one table. Never put a secret / service-role key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Newsletter signup (optional) - Buttondown, read at build time. Unset keeps
# the signup off. Letters, digits, "-" and "_" only. See docs/SETUP.md.
# BUTTONDOWN_USERNAME=your-buttondown-username

# Site Configuration (for GitHub Pages deployment)
# Leave unset to use the default in lib/site-host.mjs, or set it to the URL
# where the site is served (scheme + domain, no path).
# SITE_HOST=https://your-site.example
# ELEVENTY_PATH_PREFIX is auto-detected from GITHUB_REPOSITORY
# Only set manually if needed for non-GitHub deployments
# ELEVENTY_PATH_PREFIX=/letstalkcdc
