# Appwrite Configuration
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# Appwrite Instance (use cloud.appwrite.io or your self-hosted URL)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite Project ID (found in Appwrite Console)
APPWRITE_PROJECT=your_project_id_here

# Database ID (default: main)
APPWRITE_DB_ID=main

# Collection IDs (must match your appwrite.collections.json import)
COL_PROGRESS_ID=progress
COL_EVENTS_ID=events

# Server-side only (for netlify/functions/migrateUser.js)
# This should NEVER be exposed to the browser
APPWRITE_API_KEY=your_secret_api_key_here

# Site Configuration (for GitHub Pages deployment)
SITE_HOST=https://letstalkcdc.github.io
# ELEVENTY_PATH_PREFIX is auto-detected from GITHUB_REPOSITORY
# Only set manually if needed for non-GitHub deployments
# ELEVENTY_PATH_PREFIX=/letstalkcdc
