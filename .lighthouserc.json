{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "staticDistDir": "./_site",
      "url": [
        "http://localhost/index.html",
        "http://localhost/intro/index.html",
        "http://localhost/overview/index.html",
        "http://localhost/quickstarts/index.html",
        "http://localhost/snapshotting/index.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["warn", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
