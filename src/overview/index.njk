---
layout: base.njk
title: "Series Overview"
description: "Series hub for advanced CDC patterns. Exactly-once semantics, multi-tenancy, partitioning, and reconciliation."
canonicalPath: "/overview/"
head_extra: |
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "CDC Learning Series",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Interactive Introduction to CDC", "url": "{{ site.origin }}{{ '/intro/' | url }}"},
        {"@type": "ListItem", "position": 2, "name": "Exactly-Once Semantics", "url": "{{ site.origin }}{{ '/exactly-once/' | url }}"},
        {"@type": "ListItem", "position": 3, "name": "Multi-Tenancy: Cost vs Isolation", "url": "{{ site.origin }}{{ '/multi-tenancy/' | url }}"},
        {"@type": "ListItem", "position": 4, "name": "Hands-On Lab: Kafka + Debezium + Postgres", "url": "{{ site.origin }}{{ '/lab-kafka-debezium/' | url }}"}
      ]
    }
  </script>
---
{% import "components/ui.njk" as ui %}

{# Debug hero config #}
{# {{ heroConfig | dump }} #}
{{ ui.hero(heroConfig) | safe }}

<section class="diagram-section">
  <h2 class="diagram-section__title">CDC Pipeline Architecture</h2>
  <figure class="diagram-section__figure">
    {% img '/diagrams/cdc-pipeline-architecture.svg' | url,
      'CDC pipeline architecture showing data flow from source database through connector to stream and finally to sink',
      {
        class: 'diagram-section__image'
      }
    %}
    <figcaption class="diagram-section__caption">
      The four stages of a CDC pipeline: Source → Connector → Stream → Sink
    </figcaption>
  </figure>
</section>

<section class="diagram-section">
  <h2 class="diagram-section__title">How Change Events Flow</h2>
  <p>Click any node to highlight its connections. Hover for details.</p>
  <div class="architecture-diagram" role="img"
       aria-label="CDC data flow: database log is read by a connector, published to a streaming platform, and consumed by downstream sinks"
       data-tooltips='{"SRC":"Production database (PostgreSQL, MySQL, Oracle, SQL Server)","LOG":"Transaction log (WAL, binlog, redo log) captures every committed change","CONN":"CDC connector (Debezium) reads the log and emits structured change events","STREAM":"Streaming platform (Kafka, Pulsar, Kinesis) durably stores ordered events","SINK":"Downstream consumer applies events to a target (data warehouse, cache, search index)","SMT":"Single Message Transforms reshape events in-flight (rename fields, route, filter)"}'>
    <pre class="mermaid">
graph LR
    SRC[Source Database] -->|Transaction Log| LOG[WAL / Binlog / Redo]
    LOG -->|Read| CONN[CDC Connector]
    CONN -->|Emit Events| SMT[Transforms]
    SMT -->|Publish| STREAM[Streaming Platform]
    STREAM -->|Consume| SINK[Target System]

    style SRC fill:#e1f5ff
    style CONN fill:#fff3cd
    style STREAM fill:#d4edda
    style SINK fill:#f8d7da
    </pre>
  </div>
  <p class="diagram-section__caption">
    Interactive: click a node to highlight its path through the pipeline.
  </p>
</section>
  {% for card in seriesCards %}
    {% set targetHref = card.href %}
    {% if not card.draft and (not targetHref or collections.all | pageExists(targetHref)) %}
      {{ ui.series_card(card) | safe }}
    {% endif %}
  {% endfor %}
</section>
