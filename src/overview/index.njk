---
layout: base.njk
title: "Series Overview"
description: "Series hub for advanced CDC patterns. Exactly-once semantics, multi-tenancy, partitioning, and reconciliation."
canonicalPath: "/overview/"
head_extra: |
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "CDC Learning Series",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Interactive Introduction to CDC", "url": "{{ site.host }}{{ '/intro/' | url }}"},
        {"@type": "ListItem", "position": 2, "name": "Exactly-Once Semantics", "url": "{{ site.host }}{{ '/exactly-once/' | url }}"},
        {"@type": "ListItem", "position": 3, "name": "Multi-Tenancy: Cost vs Isolation", "url": "{{ site.host }}{{ '/multi-tenancy/' | url }}"},
        {"@type": "ListItem", "position": 4, "name": "Hands-On Lab: Kafka + Debezium + Postgres", "url": "{{ site.host }}{{ '/lab-kafka-debezium/' | url }}"}
      ]
    }
  </script>
---
{% import "components/ui.njk" as ui %}

{# Debug hero config #}
{# {{ heroConfig | dump }} #}
{{ ui.hero(heroConfig) | safe }}

<section class="diagram-section" style="max-width: 900px; margin: 2rem auto; padding: 0 1rem;">
  <h2 style="color: #e6eefc; font-size: 1.5rem; margin-bottom: 1rem; text-align: center;">CDC Pipeline Architecture</h2>
  <figure style="margin: 0;">
    <img src="{{ '/diagrams/cdc-pipeline-architecture.svg' | url }}" 
         alt="CDC pipeline architecture showing data flow from source database through connector to stream and finally to sink" 
         style="width: 100%; max-width: 100%; height: auto; display: block; background: #0b1220; border-radius: 8px; padding: 1rem;"/>
    <figcaption style="color: #94a3b8; font-size: 0.875rem; text-align: center; margin-top: 0.5rem; font-style: italic;">
      The four stages of a CDC pipeline: Source → Connector → Stream → Sink
    </figcaption>
  </figure>
</section>

<section class="series-card-grid">
  {% for card in seriesCards %}
    {{ ui.series_card(card) | safe }}
  {% endfor %}
</section>
