{% import "components/ui.njk" as ui %}

{% set navModules = series | rejectattr('state', 'equalto', 'disabled') | selectattr('href') | list %}
{% set currentIndex = -1 %}
{% set current = null %}
{% for item in navModules %}
  {% if item.key == seriesKey %}
    {% set currentIndex = loop.index0 %}
    {% set current = item %}
  {% endif %}
{% endfor %}
{% if currentIndex > -1 %}
  {% set prev = navModules[currentIndex - 1] if currentIndex > 0 %}
  {% set next = navModules[currentIndex + 1] if currentIndex + 1 < navModules | length %}
  <div class="container">
    <nav class="series-nav" aria-label="Series navigation">
      <div class="series-nav__group series-nav__group--start{% if not prev %} is-disabled{% endif %}">
        {% if prev %}
          {% set prevHref = ui.resolve_href(prev.href) %}
          <a class="series-nav__link series-nav__link--prev" href="{{ prevHref | trim }}" aria-label="Previous module: {{ prev.title }}">← {{ prev.title }}</a>
        {% endif %}
      </div>
      <div class="series-nav__group series-nav__group--center">
        <a
          class="series-nav__link series-nav__link--overview"
          href="{{ '/overview/' | url }}#series-{% if current.key %}{{ current.key }}{% endif %}"
        >
          Back to Overview
        </a>
      </div>
      <div class="series-nav__group series-nav__group--end{% if not next %} is-disabled{% endif %}">
        {% if next %}
          {% set nextHref = ui.resolve_href(next.href) %}
          <a class="series-nav__link series-nav__link--next" href="{{ nextHref | trim }}" aria-label="Next module: {{ next.title }}">{{ next.title }} →</a>
        {% endif %}
      </div>
    </nav>
    <div class="series-progress" data-progress-toolbar>
      <div class="series-progress__info">
        <span class="series-progress__label">Progress</span>
        <span class="series-progress__value" data-progress-percent>0%</span>
        <span class="series-progress__status" data-progress-status data-status="not-started">No progress yet</span>
        <div class="series-progress__bar">
          <div class="progress-bar progress-bar--md">
            <div
              class="progress-bar-fill"
              data-progress-fill
              style="width: 0%"
              role="progressbar"
              aria-valuenow="0"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-label="Series progress"
            ></div>
          </div>
        </div>
      </div>
      <div class="series-progress__note" data-progress-note>
        Progress is stored locally in this browser.
      </div>
    </div>
  </div>
{% endif %}
