{% import "components/ui.njk" as ui %}

{% macro render(ariaLabel, items, className='intro-quick-nav') %}
  <nav aria-label="{{ ariaLabel }}" class="{{ className }}">
    <ul>
      {% for item in items %}
        {% set link = item.href or ('#' + item.id) %}
        {% if link %}
          {% set link = ui.resolve_href(link) %}
        {% endif %}
        <li><a href="{{ link | trim }}">{{ item.label }}</a></li>
      {% endfor %}
    </ul>
  </nav>
{% endmacro %}
