<!DOCTYPE html>
<html lang="en" data-path-prefix="{{ '/' | url }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} | {{ site.title }}{% else %}{{ site.seoTitle }}{% endif %}</title>
    <meta name="description" content="{{ description | default(site.description) }}">
    <meta name="robots" content="index,follow,max-image-preview:large">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ '/apple-touch-icon.png' | url }}">
    <link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml">
    <link rel="icon" href="{{ '/favicon.ico' | url }}">
    {% set canonicalUrl = canonicalPath | default(page.url) %}
    {% if site.pathPrefix %}
      {% set prefix = site.pathPrefix %}
      {% if canonicalUrl | startsWith(prefix ~ '/') %}
        {% set canonicalUrl = canonicalUrl | replace(prefix ~ '/', '/') %}
      {% elseif canonicalUrl == prefix %}
        {% set canonicalUrl = '/' %}
      {% elseif canonicalUrl | startsWith(prefix) %}
        {% set canonicalUrl = canonicalUrl | replace(prefix, '') %}
      {% endif %}
    {% endif %}
    {% if canonicalUrl == '' %}
      {% set canonicalUrl = '/' %}
    {% elseif not (canonicalUrl | startsWith('/')) %}
      {% set canonicalUrl = '/' ~ canonicalUrl %}
    {% endif %}
    <link rel="canonical" href="{{ site.host }}{{ canonicalUrl }}">
    <meta name="theme-color" content="#0f172a">
    {% if head_extra %}{{ head_extra | safe }}{% endif %}
    <link rel="stylesheet" href="{{ '/assets/css/styles.min.css' | url }}">
    <link rel="stylesheet" href="{{ '/assets/css/auth.css' | url }}">
  </head>
  <body{% if seriesKey %} data-journey-slug="{{ seriesKey }}"{% endif %}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="global-header">
      <div class="nav-container">
        <a class="site-logo" href="{{ '/' | url }}" aria-label="{{ site.seoTitle }} home">
          <span class="site-logo__icon" aria-hidden="true">
            <img
              src="{{ '/images/lets-talk-cdc-logo.svg' | url }}"
              width="92"
              height="28"
              alt=""
              decoding="async"
            >
          </span>
          <span class="site-logo__wordmark" aria-hidden="true">
            <span class="site-logo__word site-logo__word--primary">Let's Talk</span>
            <span class="site-logo__word site-logo__word--accent">CDC</span>
          </span>
        </a>
        <div class="nav-right">
          <button aria-label="Toggle navigation menu" class="mobile-menu-toggle" data-mobile-menu-toggle type="button">
            <span class="hamburger-icon" aria-hidden="true"></span>
          </button>
          <nav aria-label="Primary" class="nav-links" data-mobile-nav>
            <div class="nav-links__group nav-links__group--primary">
              <a class="nav-chip {% if page.url == '/' %}active{% endif %}" href="{{ '/' | url }}">Home</a>
              <a class="nav-chip {% if page.url | startsWith('/intro') %}active{% endif %}" href="{{ '/intro/' | url }}">Intro</a>
              <a class="nav-chip {% if page.url | startsWith('/overview') %}active{% endif %}" href="{{ '/overview/' | url }}">Series</a>
              <div class="nav-dropdown">
                <button class="nav-chip nav-dropdown-toggle {% if page.url | startsWith('/quickstarts') or page.url | startsWith('/lab-') or page.url | startsWith('/cloud-labs') or page.url | startsWith('/tests') %}active{% endif %}" aria-expanded="false" aria-haspopup="true">
                  Labs
                  <span class="dropdown-icon" aria-hidden="true">▾</span>
                </button>
                <div class="nav-dropdown-menu" role="menu">
                  <a class="{% if page.url | startsWith('/quickstarts') %}active{% endif %}" href="{{ '/quickstarts/' | url }}" role="menuitem">Quick Starts</a>
                  <a class="{% if page.url | startsWith('/lab-kafka') %}active{% endif %}" href="{{ '/lab-kafka-debezium/' | url }}" role="menuitem">Kafka + Debezium Lab</a>
                  <a class="{% if page.url | startsWith('/cloud-labs') %}active{% endif %}" href="{{ '/cloud-labs/' | url }}" role="menuitem">Cloud Labs</a>
                  <a class="{% if page.url | startsWith('/tests') %}active{% endif %}" href="{{ '/tests/' | url }}" role="menuitem">Acceptance Tests</a>
                </div>
              </div>
              <div class="nav-dropdown">
                <button class="nav-chip nav-dropdown-toggle {% if page.url | startsWith('/tooling') or page.url | startsWith('/connector-builder') or page.url | startsWith('/debezium-decoder') or page.url | startsWith('/dlq-triage') %}active{% endif %}" aria-expanded="false" aria-haspopup="true">
                  Tools
                  <span class="dropdown-icon" aria-hidden="true">▾</span>
                </button>
                <div class="nav-dropdown-menu" role="menu">
                  <a class="{% if page.url | startsWith('/tooling') %}active{% endif %}" href="{{ '/tooling/' | url }}" role="menuitem">Ecosystem</a>
                  <a class="{% if page.url | startsWith('/connector-builder') %}active{% endif %}" href="{{ '/connector-builder/' | url }}" role="menuitem">Connector Builder</a>
                  <a class="{% if page.url | startsWith('/debezium-decoder') %}active{% endif %}" href="{{ '/debezium-decoder/' | url }}" role="menuitem">Event Decoder</a>
                  <a class="{% if page.url | startsWith('/dlq-triage') %}active{% endif %}" href="{{ '/dlq-triage/' | url }}" role="menuitem">DLQ Triage</a>
                </div>
              </div>
            </div>
            <div class="nav-links__group nav-links__group--support">
              <a class="nav-chip {% if page.url | startsWith('/use-cases') %}active{% endif %}" href="{{ '/use-cases/' | url }}">Cases</a>
              <a class="nav-chip {% if page.url | startsWith('/troubleshooting') %}active{% endif %}" href="{{ '/troubleshooting/' | url }}">Help</a>
              <a class="nav-chip {% if page.url | startsWith('/dashboard') %}active{% endif %}" href="{{ '/dashboard/' | url }}">Progress</a>
            </div>
          </nav>
          <div class="nav-utilities">
            <div class="header-progress" data-header-progress>
              <span class="header-progress__label">Progress</span>
              <div class="header-progress__bar">
                <div class="progress-bar progress-bar--sm">
                  <div
                    class="progress-bar-fill"
                    data-global-progress-bar
                    style="width: 0%"
                    role="progressbar"
                    aria-valuenow="0"
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-label="Overall learning progress"
                  ></div>
                </div>
              </div>
              <span class="header-progress__text" data-global-progress-text>0%</span>
            </div>
            <button aria-label="Toggle dark mode" class="theme-toggle" data-toggle-theme type="button">🌓</button>
          </div>
        </div>
      </div>
    </header>

    {% if breadcrumbs %}
    <nav aria-label="Breadcrumb" class="breadcrumb-nav">
      <div class="breadcrumb-container">
        <ol class="breadcrumb" vocab="https://schema.org/" typeof="BreadcrumbList">
          {% for crumb in breadcrumbs %}
          <li property="itemListElement" typeof="ListItem">
            {% if crumb.url %}
            <a property="item" typeof="WebPage" href="{{ crumb.url | url }}">
              <span property="name">{{ crumb.label }}</span>
            </a>
            {% else %}
            <span property="name">{{ crumb.label }}</span>
            {% endif %}
            <meta property="position" content="{{ loop.index }}">
          </li>
          {% endfor %}
        </ol>
      </div>
    </nav>
    {% endif %}

    <main id="main">
      {{ content | safe }}
      
      {# Add discussion link callout based on content type #}
      {% if seriesKey %}
        {# Determine discussion type based on series data #}
        {% set discussionType = 'general' %}
        {% for module in series %}
          {% if module.key == seriesKey %}
            {% if module.tags %}
              {% for tag in module.tags %}
                {% if tag.label == 'Lab' %}
                  {% set discussionType = 'lab' %}
                {% endif %}
              {% endfor %}
            {% endif %}
          {% endif %}
        {% endfor %}
        {% include "components/discussion-link.njk" %}
      {% endif %}
    </main>

    {% if seriesKey %}
      {% include "components/series-nav.njk" %}
    {% endif %}

    <div class="progress-toast" data-progress-toast hidden aria-live="polite">
      <div class="progress-toast__body" role="status">
        <p class="progress-toast__message" data-progress-toast-message></p>
        <div class="progress-toast__actions">
          <button type="button" class="button" data-progress-toast-resume>Resume</button>
          <button type="button" class="button ghost" data-progress-toast-dismiss>Dismiss</button>
        </div>
      </div>
    </div>

    <section class="dashboard-boot container" id="cdcDashboardBoot" aria-live="polite">
      <h2>Let&rsquo;s Talk CDC Session</h2>
      <p>Track your progress locally as you work through modules—no sign-in required.</p>
    </section>

    <section class="cdc-dashboard container" id="cdcDashboard" hidden aria-labelledby="cdcDashboardTitle">
      <header>
        <h2 id="cdcDashboardTitle">Let&rsquo;s Talk CDC Interactive Dashboard</h2>
        <p>Track journey completion, monitor recent activity, and export your session logs.</p>
      </header>
      <div class="dashboard-charts">
        <canvas id="cdc-progress-overall" aria-label="Overall progress" role="img"></canvas>
        <canvas id="cdc-progress-modules" aria-label="Module progress" role="img"></canvas>
      </div>
      <div class="dashboard-legend" id="progressLegend" aria-live="polite"></div>
      <div class="dashboard-footer" id="progressFooter" data-last-completed="0" aria-live="polite"></div>
      <div class="agent-console" id="agentConsole" aria-live="polite">
        <div class="agent-scroll" role="log" aria-live="polite" aria-label="CDC agent activity"></div>
      </div>
    </section>

    <div class="stats-wrapper" aria-live="polite">
      <button type="button" class="stats-chip" id="statsButton" aria-haspopup="dialog" aria-controls="sessionModal">
        <span class="sr-only">Open dashboard activity</span>
        <span aria-hidden="true">📊</span>
        <span class="stats-counter" id="statsCounter">0</span>
      </button>
    </div>

    <div class="session-modal hidden" id="sessionModal" role="dialog" aria-modal="true" aria-labelledby="sessionModalTitle">
      <div class="modal-content">
        <header>
          <h2 id="sessionModalTitle">Session Activity</h2>
        </header>
        <div id="sessionDetails"></div>
        <div class="export-controls">
          <button type="button" id="exportTxt">Export TXT</button>
          <button type="button" id="exportJson">Export JSON</button>
        </div>
        <button type="button" class="button ghost" id="closeModal">Close</button>
      </div>
    </div>

    <script>
      (function () {
        const attr = document.documentElement.dataset.pathPrefix || '/';
        const prefix = attr === '/' ? '' : attr.replace(/\/$/, '');
        window.__PATH_PREFIX__ = prefix;

        if (!prefix) {
          return;
        }

        const rewriteAttribute = (element, attribute) => {
          const value = element.getAttribute(attribute);
          if (!value || value.startsWith('http') || value.startsWith('mailto:') || value.startsWith('tel:') || value.startsWith('#')) {
            return;
          }
          if (!value.startsWith('/') || value.startsWith(prefix)) {
            return;
          }
          element.setAttribute(attribute, `${prefix}${value}`);
        };

        const adjustDom = () => {
          document.querySelectorAll('a[href^="/"]').forEach((el) => rewriteAttribute(el, 'href'));
          document.querySelectorAll('img[src^="/"]').forEach((el) => rewriteAttribute(el, 'src'));
          document.querySelectorAll('script[src^="/"]').forEach((el) => rewriteAttribute(el, 'src'));
          document.querySelectorAll('form[action^="/"]').forEach((el) => rewriteAttribute(el, 'action'));
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', adjustDom, { once: true });
        } else {
          adjustDom();
        }
      })();
    </script>
    <script>
      window.CDC_MODULES = {{ series | dump | safe }};
    </script>
    <script type="module" src="{{ '/scripts/dashboard.js' | url }}"></script>
    <script type="module" src="{{ '/assets/js/app.js' | url }}"></script>
    <script type="module" src="{{ '/assets/js/progress-ui.js' | url }}"></script>
    <script type="module" src="{{ '/assets/js/auth-ui.js' | url }}"></script>
    <script type="module" src="{{ '/assets/js/cloud-progress.js' | url }}"></script>
    <script type="module" src="{{ '/assets/js/video-embed.js' | url }}"></script>
    {% if scripts %}
      {% for script in scripts %}
        <script type="module" src="{{ script | url }}"></script>
      {% endfor %}
    {% endif %}
    {% if appwrite.endpoint and appwrite.project and appwrite.databaseId %}
      <script>
        window.APPWRITE_ENDPOINT = {{ appwrite.endpoint | dump | safe }};
        window.APPWRITE_PROJECT = {{ appwrite.project | dump | safe }};
        window.APPWRITE_DB_ID = {{ appwrite.databaseId | dump | safe }};
        {%- if appwrite.assistantCollectionId %}
        window.COL_ASSISTANT_ID = {{ appwrite.assistantCollectionId | dump | safe }};
        {%- endif %}
      </script>
    {% endif %}
    {% if seriesKey %}
      <script>
        window.CDC_JOURNEY_SLUG = {{ seriesKey | dump | safe }};
      </script>
      <script type="module" src="{{ '/scripts/progress.js' | url }}"></script>
    {% endif %}
    <footer class="site-footer">
      <div class="footer-container">
        <div class="footer-grid">
          <div class="footer-section">
            <h3 class="footer-title">About CDC</h3>
            <p class="footer-description">{{ site.tagline }}</p>
            <p class="footer-description">A comprehensive guide to Change Data Capture patterns, best practices, and production-ready implementations.</p>
          </div>
          
          <div class="footer-section">
            <h3 class="footer-title">Learn</h3>
            <ul class="footer-links">
              <li><a href="{{ '/intro/' | url }}">Introduction</a></li>
              <li><a href="{{ '/overview/' | url }}">Series Overview</a></li>
              <li><a href="{{ '/quickstarts/' | url }}">Quick Starts</a></li>
              <li><a href="{{ '/tooling/' | url }}">Ecosystem</a></li>
            </ul>
          </div>
          
          <div class="footer-section">
            <h3 class="footer-title">Resources</h3>
            <ul class="footer-links">
              <li><a href="{{ '/use-cases/' | url }}">Use Cases</a></li>
              <li><a href="{{ '/troubleshooting/' | url }}">Troubleshooting</a></li>
              <li><a href="{{ '/schema-evolution/' | url }}">Schema Evolution</a></li>
              <li><a href="{{ '/exactly-once/' | url }}">Exactly-Once</a></li>
              <li><a href="{{ '/versions/' | url }}">Changelog &amp; Version Matrix</a></li>
            </ul>
          </div>
          
          <div class="footer-section">
            <h3 class="footer-title">Connect</h3>
            <ul class="footer-links">
              <li><a href="https://github.com/{{ site.repository }}" target="_blank" rel="noopener">GitHub</a></li>
              {% if community.discussions.enabled %}
              <li>
                <a href="{{ community.discussions.url }}" target="_blank" rel="noopener" class="footer-highlight-link">
                  💬 {{ community.discussions.label }}
                </a>
                <p class="footer-link-description">{{ community.discussions.description }}</p>
              </li>
              {% endif %}
              {% if community.discord.enabled %}
              <li><a href="{{ community.discord.url }}" target="_blank" rel="noopener">{{ community.discord.label }}</a></li>
              {% endif %}
              {% if community.slack.enabled %}
              <li><a href="{{ community.slack.url }}" target="_blank" rel="noopener">{{ community.slack.label }}</a></li>
              {% endif %}
              <li><a href="{{ '/errata/' | url }}">Report Issue</a></li>
            </ul>
          </div>
        </div>
        
        <div class="footer-bottom">
          <p class="footer-copyright">{{ site.copyright }}</p>
          <p class="footer-meta">Built with <a href="https://www.11ty.dev/" target="_blank" rel="noopener">Eleventy</a> • Open Source Educational Project</p>
        </div>
      </div>
    </footer>
    <link rel="stylesheet" href="{{ '/css/assistant.css' | url }}">
    <button id="askBtn" type="button" aria-label="Ask the Playground">💬</button>
    <div id="askPanel" hidden></div>
    <script type="module" src="{{ '/js/assistant.js' | url }}"></script>
    <script type="module" src="{{ '/assets/js/search.js' | url }}"></script>
    <script type="module" src="{{ '/assets/js/web-vitals-dashboard.js' | url }}"></script>
  </body>
</html>
