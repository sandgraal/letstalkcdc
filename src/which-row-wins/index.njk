        <tr>
          <th scope="row">BigQuery CDC ingestion</th>
          <td><code>PRIMARY KEY ... NOT ENFORCED</code> (up to 16 columns)</td>
          <td>The record BigQuery ingested most recently. Equal sequence numbers: latest ingestion time.</td>
          <td><code>_CHANGE_SEQUENCE_NUMBER</code>, a hex <code>STRING</code>; the larger value wins</td>
          <td><code>_CHANGE_TYPE = 'DELETE'</code>; held 2 days for out-of-order deletes</td>
        </tr>
        <tr>
          <th scope="row">Databricks AUTO CDC</th>
          <td><code>KEYS (...)</code></td>
