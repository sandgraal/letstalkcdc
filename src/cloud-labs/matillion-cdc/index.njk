ALTER TABLE customers 
ADD COLUMN updated_at TIMESTAMP 
DEFAULT CURRENT_TIMESTAMP 
ON UPDATE CURRENT_TIMESTAMP;

-- Create index for efficient CDC queries
CREATE INDEX idx_updated_at ON customers(updated_at);

-- Verify data
