{
  "name": "cdc-missing-manual",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf dist _site src/assets/css/styles.min.css",
    "build:css": "postcss src/assets/css/main.css -o src/assets/css/styles.min.css",
    "build:js": "vite build",
    "build:11ty": "NODE_ENV=production eleventy --config=eleventy.config.mjs",
    "build": "NODE_ENV=production npm run build:css && NODE_ENV=production npm run build:js && npm run build:11ty && NODE_ENV=production npx postcss _site/assets/css/styles.css -o _site/assets/css/styles.css",
    "build:lhci": "ELEVENTY_PATH_PREFIX=/ npm run build",
    "lint:content": "node scripts/lint-content.js",
    "smoke:core": "node scripts/smoke.mjs && node scripts/visual-smoke.mjs",
    "smoke:a11y": "node scripts/run-pa11y.mjs",
    "smoke:perf": "node scripts/perf-budget.mjs",
    "smoke": "npm run smoke:core && npm run smoke:a11y && npm run smoke:perf",
    "preserve": "npm run build:css",
    "serve": "eleventy --config=eleventy.config.mjs --serve",
    "dev": "npm run serve",
    "a11y": "pa11y-ci",
    "verify:deployment": "node scripts/deployment-verify.mjs",
    "seed:discussions": "node scripts/seed-discussions.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "lighthouse": "lhci autorun",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify-all": "npm run format:check && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.1.2",
    "dotenv": "^17.2.3",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "jsdom": "^28.0.0",
    "pa11y-ci": "^4.1.1",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.1",
    "rimraf": "^5.0.5",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "fuse.js": "^7.1.0"
  }
}
