{
  "name": "cdc-missing-manual",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf dist _site src/assets/css/styles.min.css",
    "build:css": "postcss src/assets/css/main.css -o src/assets/css/styles.min.css",
    "build:dark-theme": "node scripts/build-dark-theme.mjs",
    "build:js": "vite build",
    "build:11ty": "NODE_ENV=production eleventy --config=eleventy.config.mjs",
    "build": "NODE_ENV=production npm run build:dark-theme && NODE_ENV=production npm run build:css && NODE_ENV=production npm run build:js && npm run build:11ty && NODE_ENV=production npx postcss _site/assets/css/styles.css -o _site/assets/css/styles.css",
    "lint:content": "node scripts/lint-content.js",
    "smoke:core": "node scripts/smoke.mjs && node scripts/visual-smoke.mjs",
    "smoke:a11y": "node scripts/run-pa11y.mjs",
    "smoke:perf": "node scripts/perf-budget.mjs",
    "smoke": "npm run smoke:core && npm run smoke:a11y && npm run smoke:perf",
    "serve": "eleventy --config=eleventy.config.mjs --serve",
    "dev": "npm run serve",
    "a11y": "pa11y-ci",
    "verify:deployment": "node scripts/deployment-verify.mjs",
    "agent:analytics": "node ai/scripts/analytics.mjs",
    "agent:package": "node ai/scripts/package-render.mjs",
    "agent:content-review": "node ai/scripts/content-review.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.207.0",
    "@opentelemetry/instrumentation-document-load": "^0.53.0",
    "@opentelemetry/instrumentation-fetch": "^0.207.0",
    "@opentelemetry/instrumentation-user-interaction": "^0.52.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.207.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-trace-web": "^2.2.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.1.2",
    "csso": "^5.0.5",
    "dotenv": "^17.2.3",
    "jsdom": "^28.0.0",
    "pa11y-ci": "^4.0.1",
    "postcss": "^8.4.41",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.1",
    "postcss-prefix-selector": "^2.1.1",
    "rimraf": "^5.0.5",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
